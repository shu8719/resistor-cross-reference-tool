{
  "name": "resistor-cross-reference",
  // Generated by the build step below; edit worker.py at the repo root.
  "main": "build/worker/worker.py",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["python_workers"],
  "build": {
    "command": "sh scripts/build_cloudflare.sh"
  },
  // index.html and /static/* are served as static assets; requests that match no file
  // (POST /analyze, /analyze_bulk, /upload_bulk) go to Flask.
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
